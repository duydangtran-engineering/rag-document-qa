# Copy this file to ".env" and fill in your own key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here

# Generation model
GEMINI_MODEL=gemini-2.5-flash

# Embedding model (multilingual, strong on Vietnamese)
EMBEDDING_MODEL=BAAI/bge-m3

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5

# Reranking (cross-encoder chạy cục bộ trên GPU, lần đầu tải ~2.2GB)
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=20
# Loại chunk có điểm rerank thấp hơn ngưỡng (0 = không loại). Chọn theo eval.
RERANK_MIN_SCORE=0

# Model dự phòng: khi GEMINI_MODEL hết hạn mức (429), không dùng được (404) hoặc
# quá tải (503) thì tự chuyển sang model kế tiếp. Mỗi model có hạn mức riêng.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-2.5-flash

# Lưu câu trả lời: hỏi lại đúng câu cũ (cùng đoạn tài liệu) thì trả ngay, không gọi API
ANSWER_CACHE=1
